{
  "manifest_version": 3,
  "name": "Tab Keys",
  "version": "3.3",
  "description": "Tab and tab-group shortcuts: ⌘ / Ctrl for tabs, ⌃⌘ / Alt for groups, N next, P previous, T new, ⇧ to move. Works on every page, the New Tab page and chrome:// included",
  "permissions": [
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "next-tab": {
      "description": "Next tab (⌘N · Ctrl+N)"
    },
    "previous-tab": {
      "description": "Previous tab (⌘P · Ctrl+P)"
    },
    "move-tab-right": {
      "description": "Move tab right (⌘⇧N · Ctrl+Shift+N)"
    },
    "move-tab-left": {
      "description": "Move tab left (⌘⇧P · Ctrl+Shift+P)",
      "suggested_key": {
        "mac": "Command+Shift+P"
      }
    },
    "next-group": {
      "description": "Next tab group (⌃⌘N · Alt+N)",
      "suggested_key": {
        "mac": "MacCtrl+Command+N",
        "linux": "Alt+N"
      }
    },
    "previous-group": {
      "description": "Previous tab group (⌃⌘P · Alt+P)",
      "suggested_key": {
        "mac": "MacCtrl+Command+P",
        "linux": "Alt+P"
      }
    },
    "move-group-right": {
      "description": "Move tab group right (⌃⌘⇧N · Alt+Shift+N)"
    },
    "move-group-left": {
      "description": "Move tab group left (⌃⌘⇧P · Alt+Shift+P)"
    },
    "new-group": {
      "description": "New tab in a new tab group (⌃⌘T · Alt+T)",
      "suggested_key": {
        "mac": "MacCtrl+Command+T",
        "linux": "Alt+T"
      }
    }
  }
}
