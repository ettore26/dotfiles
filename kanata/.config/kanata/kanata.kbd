;; Simple Kanata Config: Right Option -> Control, Caps Lock -> Esc (tap) / cursor-move layer (hold),
;; every other key as on the stock MacBook keyboard

(defcfg
  process-unmapped-keys yes  ;; crucial: passes all other keys through normally
)

;; macOS only applies the top-row media keys and fn+arrows/delete/return to the built-in keyboard
;; (FnFunctionUsageMap / FnKeyboardUsageMap in `ioreg -l`). kanata re-sends every key through the
;; Karabiner virtual keyboard, which has neither map, so both are rebuilt here.
(deflocalkeys-macos
  rwd 168  ;; Rewind (consumer 0xB4), the stock F7; kanata 1.12 has no name for it
)

(defsrc
  ralt  ;; This represents the physical "Right Option" key
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  left up   rght down bspc ret
  fn
  caps h    j    k    l    w    b    0    4
)

(defalias
  ;; Esc when tapped; the nav layer once another key is pressed and released, or after 200 ms
  cap (tap-hold-release 200 200 esc (layer-while-held nav))
)

(deflayer default
  rctl  ;; This maps it to "Right Control"
  brdn brup mctl sls  dtn  dnd  rwd  pp   fwd  mute vold volu
  _    _    _    _    _    _
  (multi fn (layer-while-held fnkeys))  ;; fn still reaches macOS, so Globe shortcuts keep working
  @cap _    _    _    _    _    _    _    _
)

;; While fn is held
(deflayer fnkeys
  _
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  home pgup end  pgdn del  kprt
  _
  _    _    _    _    _    _    _    _    _
)

;; While Caps Lock is held: hjkl arrows, w/b word jumps, 0/$ line start/end (add Shift to select)
(deflayer nav
  _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _
  _
  _    left down up   rght A-rght A-left M-left M-rght
)
